        "reported_page": 6,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
        "style_signature": {
          "font-family": "'arial',sans-serif",
          "font-size": "10pt",
          "font-weight": "400",
          "line-height": "112%",
          "padding-left": "72pt",
          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "◦Gemini for Google Workspace: brings our AI-powered agents into Gmail, Docs, Sheets, and more to help users write, organize, visualize, accelerate workflows, and have more productive meetings.",
        "text_hash": "6e57c03e24a9ae931b1e21445b954971201fa89477f52ccde8095c13a4c4c936",
