          "line-height": "120%",
          "margin-top": "6pt",
          "padding-left": "36pt",
          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "•general purpose search engines and information services;",
        "text_hash": "8323e69e6495228274070c181f0b22480d5416fe76896bfbaa3339db910ccc84",
        "type": "list_item"
      },
      {
