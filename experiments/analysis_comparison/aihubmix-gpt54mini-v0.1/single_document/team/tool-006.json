          "text-align": "justify"
        },
        "table": null,
        "text": "Competition",
        "text_hash": "449303332f88997ae6389add7de42f361aa69068157b81b78327e111fc7f63b0",
        "type": "heading_candidate"
      },
      {
        "block_id": "block-000117-9c656dbe",
