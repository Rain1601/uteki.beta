{
  "$defs": {
    "Citation": {
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "index_id": {
          "title": "Index Id",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "index_id",
        "block_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Paragraph": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "text",
        "kind",
        "citations"
      ],
      "title": "Paragraph",
      "type": "object"
    },
    "Section": {
      "properties": {
        "key": {
          "enum": [
            "business",
            "industry",
            "earnings",
            "valuation",
            "watch"
          ],
          "title": "Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/Paragraph"
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        }
      },
      "required": [
        "key",
        "title",
        "paragraphs"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "thesis": {
      "$ref": "#/$defs/Paragraph"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Sections",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "stop_reason": {
      "title": "Stop Reason",
      "type": "string"
    }
  },
  "required": [
    "title",
    "thesis",
    "sections",
    "limitations",
    "stop_reason"
  ],
  "title": "Report",
  "type": "object"
}