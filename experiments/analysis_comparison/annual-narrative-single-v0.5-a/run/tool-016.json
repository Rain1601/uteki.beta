        "reported_page": 29,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_82",
        "table": null,
        "text": "•YouTube ads, which includes revenues generated on YouTube properties; and",
        "text_hash": "cbea10bbe4c18274bcfdd6c727f055ee9825373723174642d32f1d028ceccce2",
        "type": "paragraph"
      },
