        "reported_page": 29,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_82",
        "table": null,
        "text": "Google Advertising",
        "text_hash": "6fbc0dcb438be8d3f9cf6801706dfe301f88a49970230aaacfb5491e80800b07",
        "type": "paragraph"
      },
      {
