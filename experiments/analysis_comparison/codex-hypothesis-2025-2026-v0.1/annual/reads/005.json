        "table": null,
        "text": "YouTube ads",
        "text_hash": "3aa9449d4867f43e73cbb9512ade84417857a82ee2e101bd1d8bef97e5c8e326",
        "type": "paragraph"
      },
      {
        "block_id": "block-000519-66721118",
        "dom_path": "/html/body/div[556]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 519,
        "reported_page": 34,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_100",
        "style_signature": {
