          "margin-top": "6pt",
          "text-align": "justify",
          "text-indent": "22.5pt"
        },
        "table": null,
        "text": "Other Bets",
        "text_hash": "cf90ed0b1db4f96e794aa7e2437cc0f837dd38117d650bd6392c43966aeb267e",
        "type": "heading_candidate"
      },
      {
        "block_id": "block-000569-2ac84edf",
        "dom_path": "/html/body/div[613]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 569,
        "reported_page": 36,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_136",
        "style_signature": {
          "font-family": "'arial',sans-serif",
          "font-size": "10pt",
          "font-weight": "400",
          "line-height": "120%",
          "margin-top": "6pt",
          "text-align": "justify",
          "text-indent": "22.5pt"
        },
        "table": null,
        "text": "Other Bets operating loss increased $3.1 billion from 2024 to 2025. The increase in operating loss was primarily driven by an increase in employee compensation expenses largely due to an increase in a valuation-based compensation charge related to Waymo.",
        "text_hash": "2ac84edf399e62a9a269e7b039e600d46e6d47f8fe8cb674dac1cb2397ab8e3c",
        "type": "paragraph"
