        ]
      },
      "payload": {
        "text": "Alphabet is a collection of businesses — the largest of which is Google. We report Google in two segments, Google Services and Google Cloud, and all non-Google businesses collectively as Other Bets. Supporting these businesses, we have centralized certain AI-related research and development focused on advanced research in AI and developing the frontier models that serve our businesses, which is reported in Alphabet-level activities. Alphabet's structure is about helping each of our businesses prosper through strong leaders and independence.",
        "block": {
          "block_id": "block-000059-ab2556c8",
          "dom_path": "/html/body/div[71]",
          "image_asset_id": null,
