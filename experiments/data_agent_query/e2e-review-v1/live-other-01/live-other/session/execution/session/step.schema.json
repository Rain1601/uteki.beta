{
  "$defs": {
    "CalculationRequest": {
      "additionalProperties": false,
      "properties": {
        "formula_id": {
          "enum": [
            "operating_margin",
            "revenue_yoy",
            "operating_income_yoy",
            "operating_margin_delta_pp"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entity Id",
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        }
      },
      "required": [
        "formula_id",
        "entity_id",
        "periods"
      ],
      "title": "CalculationRequest",
      "type": "object"
    },
    "DocumentRequest": {
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "description": "Explicit company identifier from source discovery; no default company.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Company Id",
          "type": "string"
        },
        "form": {
          "enum": [
            "10-K",
            "10-Q",
            "EARNINGS_CALL"
          ],
          "title": "Form",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "phrase": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "limit": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "company_id",
        "form",
        "period_end",
        "phrase"
      ],
      "title": "DocumentRequest",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Calendar fiscal periods only; other fiscal calendars require a new adapter.",
      "properties": {
        "kind": {
          "enum": [
            "quarter",
            "ytd",
            "year",
            "instant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordRequest"
          },
          "maxItems": 16,
          "title": "Records",
          "type": "array"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentRequest"
          },
          "maxItems": 4,
          "title": "Documents",
          "type": "array"
        },
        "calculations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CalculationRequest"
          },
          "maxItems": 8,
          "title": "Calculations",
          "type": "array"
        }
      },
      "title": "QueryPlan",
      "type": "object"
    },
    "ReadCursor": {
      "additionalProperties": false,
      "properties": {
        "cursor_version": {
          "const": "document-cursor-v1",
          "default": "document-cursor-v1",
          "title": "Cursor Version",
          "type": "string"
        },
        "scope_id": {
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "index_id": {
          "minLength": 1,
          "title": "Index Id",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "kind": {
          "const": "read",
          "default": "read",
          "title": "Kind",
          "type": "string"
        },
        "start_block_id": {
          "minLength": 1,
          "title": "Start Block Id",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "snapshot_id",
        "source_snapshot_id",
        "index_id",
        "node_id",
        "start_block_id"
      ],
      "title": "ReadCursor",
      "type": "object"
    },
    "RecordRequest": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entity Id",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Metric Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_kind": {
          "default": "actual",
          "enum": [
            "actual",
            "management_guidance",
            "attributed_statement"
          ],
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "metric_id",
        "period"
      ],
      "title": "RecordRequest",
      "type": "object"
    },
    "SearchCursor": {
      "additionalProperties": false,
      "properties": {
        "cursor_version": {
          "const": "document-cursor-v1",
          "default": "document-cursor-v1",
          "title": "Cursor Version",
          "type": "string"
        },
        "scope_id": {
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "index_id": {
          "minLength": 1,
          "title": "Index Id",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "kind": {
          "const": "search",
          "default": "search",
          "title": "Kind",
          "type": "string"
        },
        "phrase": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Phrase",
          "type": "string"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        }
      },
      "required": [
        "scope_id",
        "snapshot_id",
        "source_snapshot_id",
        "index_id",
        "node_id",
        "phrase",
        "offset"
      ],
      "title": "SearchCursor",
      "type": "object"
    },
    "SourceOutlineRequest": {
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id"
      ],
      "title": "SourceOutlineRequest",
      "type": "object"
    },
    "SourceReadRequest": {
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Node Id",
          "type": "string"
        },
        "start_block_id": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Block Id"
        },
        "count": {
          "default": 8,
          "maximum": 12,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_snapshot_id",
        "node_id"
      ],
      "title": "SourceReadRequest",
      "type": "object"
    },
    "SourceSearchRequest": {
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Node Id",
          "type": "string"
        },
        "phrase": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Phrase",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null starts at zero, or resumes from the supplied cursor.",
          "title": "Offset"
        },
        "limit": {
          "default": 8,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_snapshot_id",
        "node_id",
        "phrase"
      ],
      "title": "SourceSearchRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Requests only: no imported result, progress, completion or scope override.",
  "properties": {
    "task_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "requirement_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Requirement Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "outline_source",
        "read_source",
        "search_source",
        "query"
      ],
      "title": "Action",
      "type": "string"
    },
    "outline": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceOutlineRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "read": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceReadRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "search": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSearchRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "query": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "requirement_id",
    "action"
  ],
  "title": "TaskStep",
  "type": "object"
}
