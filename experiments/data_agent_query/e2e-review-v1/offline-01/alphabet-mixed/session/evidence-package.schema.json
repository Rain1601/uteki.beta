{
  "$defs": {
    "ComputedScalar": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "additionalProperties": true,
          "title": "Fact",
          "type": "object"
        }
      },
      "required": [
        "fact"
      ],
      "title": "ComputedScalar",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "block_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        },
        "mode": {
          "enum": [
            "body_returned",
            "provenance_only",
            "navigation_only",
            "image_reference_only"
          ],
          "title": "Mode",
          "type": "string"
        },
        "semantic_completeness": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Semantic Completeness",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id",
        "mode"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_text",
            "source_table",
            "source_quote",
            "image_reference",
            "normalized_record",
            "computed_scalar",
            "model_extract",
            "model_summary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "locators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceLocator"
          },
          "title": "Locators",
          "type": "array"
        },
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceText"
            },
            {
              "$ref": "#/$defs/SourceTable"
            },
            {
              "$ref": "#/$defs/SourceQuote"
            },
            {
              "$ref": "#/$defs/ImageReference"
            },
            {
              "$ref": "#/$defs/NormalizedRecord"
            },
            {
              "$ref": "#/$defs/ComputedScalar"
            },
            {
              "$ref": "#/$defs/ModelExtract"
            },
            {
              "$ref": "#/$defs/ModelSummary"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "source_snapshot_ids",
        "provenance",
        "payload"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Gap Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "detail": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "reason",
        "detail"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "ExecutionScope": {
      "additionalProperties": false,
      "properties": {
        "execution_schema_version": {
          "const": "research-execution-v1",
          "default": "research-execution-v1",
          "title": "Execution Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "company_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Company Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "source_policy_id": {
          "const": "local-frozen-v1",
          "title": "Source Policy Id",
          "type": "string"
        },
        "knowledge_cutoff": {
          "format": "date",
          "title": "Knowledge Cutoff",
          "type": "string"
        },
        "include_candidates": {
          "default": false,
          "title": "Include Candidates",
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_id",
        "company_ids",
        "source_snapshot_ids",
        "source_policy_id",
        "knowledge_cutoff"
      ],
      "title": "ExecutionScope",
      "type": "object"
    },
    "ImageReference": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "default": "",
          "title": "Alt Text",
          "type": "string"
        },
        "image_asset_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Asset Id"
        },
        "asset_metadata": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Metadata"
        },
        "bytes_status": {
          "enum": [
            "verified_local",
            "metadata_only",
            "unresolved"
          ],
          "title": "Bytes Status",
          "type": "string"
        },
        "bytes_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Sha256"
        },
        "ocr_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Ocr Status",
          "type": "string"
        },
        "vision_status": {
          "const": "not_run",
          "default": "not_run",
          "title": "Vision Status",
          "type": "string"
        }
      },
      "required": [
        "bytes_status"
      ],
      "title": "ImageReference",
      "type": "object"
    },
    "ModelExtract": {
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "additionalProperties": true,
          "title": "Extraction",
          "type": "object"
        }
      },
      "required": [
        "extraction"
      ],
      "title": "ModelExtract",
      "type": "object"
    },
    "ModelSummary": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "NormalizedRecord": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "$ref": "#/$defs/ResearchRecord"
        },
        "origin_kind": {
          "enum": [
            "deterministic",
            "model_assisted",
            "unknown"
          ],
          "title": "Origin Kind",
          "type": "string"
        }
      },
      "required": [
        "record",
        "origin_kind"
      ],
      "title": "NormalizedRecord",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Calendar fiscal periods only; other fiscal calendars require a new adapter.",
      "properties": {
        "kind": {
          "enum": [
            "quarter",
            "ytd",
            "year",
            "instant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "source_read",
            "source_quote",
            "normalization",
            "registered_calculation",
            "model",
            "unknown"
          ],
          "title": "Method",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Method Id",
          "type": "string"
        },
        "input_artifact_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Artifact Id"
        },
        "input_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Path"
        },
        "input_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Sha256"
        },
        "provider": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Sha256"
        },
        "verification": {
          "enum": [
            "source_verified",
            "snapshot_verified",
            "declared_unverified"
          ],
          "title": "Verification",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "method",
        "method_id",
        "verification"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ResearchRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "research-query-v0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "enum": [
            "metric",
            "guidance",
            "statement"
          ],
          "title": "Record Type",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_resolution": {
          "default": "resolved",
          "enum": [
            "resolved",
            "unresolved",
            "not_applicable"
          ],
          "title": "Period Resolution",
          "type": "string"
        },
        "value_kind": {
          "enum": [
            "actual",
            "management_guidance",
            "attributed_statement"
          ],
          "title": "Value Kind",
          "type": "string"
        },
        "value_decimal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Decimal"
        },
        "upper_decimal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Decimal"
        },
        "value_relation": {
          "enum": [
            "eq",
            "approx",
            "gt",
            "gte",
            "range",
            "qualitative",
            "unresolved"
          ],
          "title": "Value Relation",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "modality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality"
        },
        "accounting_basis": {
          "title": "Accounting Basis",
          "type": "string"
        },
        "dimensions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "object"
        },
        "available_at": {
          "format": "date",
          "title": "Available At",
          "type": "string"
        },
        "source_snapshot_id": {
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "qualifier_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Qualifier Evidence Ids",
          "type": "array"
        },
        "question_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Question Evidence Ids",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "additionalProperties": true,
          "title": "Origin",
          "type": "object"
        },
        "normalization_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Normalization Notes",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "record_type",
        "entity_id",
        "metric_id",
        "period",
        "value_kind",
        "value_decimal",
        "value_relation",
        "unit",
        "accounting_basis",
        "available_at",
        "source_snapshot_id",
        "evidence_ids",
        "summary",
        "origin"
      ],
      "title": "ResearchRecord",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "source_snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_url": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "index_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Id"
        },
        "block_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "reported_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Page"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        },
        "dom_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dom Path"
        },
        "text_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Hash"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "cell": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "region_coordinate_system": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Coordinate System"
        }
      },
      "required": [
        "source_snapshot_id"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "SourceQuote": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "SourceQuote",
      "type": "object"
    },
    "SourceTable": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "table": {
          "additionalProperties": true,
          "title": "Table",
          "type": "object"
        },
        "block": {
          "additionalProperties": true,
          "title": "Block",
          "type": "object"
        }
      },
      "required": [
        "text",
        "table",
        "block"
      ],
      "title": "SourceTable",
      "type": "object"
    },
    "SourceText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "block": {
          "additionalProperties": true,
          "title": "Block",
          "type": "object"
        }
      },
      "required": [
        "text",
        "block"
      ],
      "title": "SourceText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "retrieval-evidence-v1",
      "default": "retrieval-evidence-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "bundle_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Bundle Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ExecutionScope"
    },
    "source_companies": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Companies",
      "type": "object"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "bindings": {
