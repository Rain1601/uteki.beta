{
  "$defs": {
    "ConditionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "satisfied",
            "missing_evidence",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "computed_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Computed Ids",
          "type": "array"
        },
        "event_sequences": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Event Sequences",
          "type": "array"
        },
        "remaining_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Count"
        }
      },
      "required": [
        "check_id",
        "status",
        "reason",
        "detail"
      ],
      "title": "ConditionCheck",
      "type": "object"
    },
    "RequirementAssessment": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "status": {
          "enum": [
            "satisfied",
            "missing_evidence",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ConditionCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "retained_issues": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Retained Issues",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "condition",
        "status",
        "checks"
      ],
      "title": "RequirementAssessment",
      "type": "object"
    },
    "TaskAssessment": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "satisfied",
            "missing_evidence",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "dependency_checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ConditionCheck"
          },
          "title": "Dependency Checks",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementAssessment"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "status",
        "requirements"
      ],
      "title": "TaskAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "retrieval-task-completion-v1",
      "default": "retrieval-task-completion-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "progress_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Progress Sha256",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "step_limit": {
      "minimum": 1,
      "title": "Step Limit",
      "type": "integer"
    },
    "steps_remaining": {
      "minimum": 0,
      "title": "Steps Remaining",
      "type": "integer"
    },
    "conditions_status": {
      "enum": [
        "satisfied",
        "missing_evidence",
        "blocked"
      ],
      "title": "Conditions Status",
      "type": "string"
    },
    "status": {
      "enum": [
        "satisfied",
        "missing_evidence",
        "blocked",
        "limited"
      ],
      "title": "Status",
      "type": "string"
    },
    "finish_allowed": {
      "title": "Finish Allowed",
      "type": "boolean"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskAssessment"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "semantic_completeness": {
      "const": "not_evaluated",
      "default": "not_evaluated",
      "title": "Semantic Completeness",
      "type": "string"
    },
    "scope_note": {
      "default": "Engineering conditions for the explicit plan only; not semantic completeness, source extraction recall, or adoption.",
      "title": "Scope Note",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_sha256",
    "progress_sha256",
    "sequence",
    "step_limit",
    "steps_remaining",
    "conditions_status",
    "status",
    "finish_allowed",
    "tasks"
  ],
  "title": "CompletionAssessment",
  "type": "object"
}
