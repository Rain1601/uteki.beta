{
  "$defs": {
    "CalculationRequest": {
      "additionalProperties": false,
      "properties": {
        "formula_id": {
          "enum": [
            "operating_margin",
            "revenue_yoy",
            "operating_income_yoy",
            "operating_margin_delta_pp"
          ],
          "title": "Formula Id",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entity Id",
          "type": "string"
        },
        "periods": {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Periods",
          "type": "array"
        }
      },
      "required": [
        "formula_id",
        "entity_id",
        "periods"
      ],
      "title": "CalculationRequest",
      "type": "object"
    },
    "ClarificationRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clarification",
          "title": "Kind",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "question": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "condition": {
          "const": "caller_clarification_required",
          "default": "caller_clarification_required",
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "requirement_id",
        "question"
      ],
      "title": "ClarificationRequirement",
      "type": "object"
    },
    "DocumentRequest": {
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "description": "Explicit company identifier from source discovery; no default company.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Company Id",
          "type": "string"
        },
        "form": {
          "enum": [
            "10-K",
            "10-Q",
            "EARNINGS_CALL"
          ],
          "title": "Form",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "phrase": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Phrase",
          "type": "string"
        },
        "limit": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "company_id",
        "form",
        "period_end",
        "phrase"
      ],
      "title": "DocumentRequest",
      "type": "object"
    },
    "ExecutionScope": {
      "additionalProperties": false,
      "properties": {
        "execution_schema_version": {
          "const": "research-execution-v1",
          "default": "research-execution-v1",
          "title": "Execution Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "company_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Company Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "source_policy_id": {
          "const": "local-frozen-v1",
          "title": "Source Policy Id",
          "type": "string"
        },
        "knowledge_cutoff": {
          "format": "date",
          "title": "Knowledge Cutoff",
          "type": "string"
        },
        "include_candidates": {
          "default": false,
          "title": "Include Candidates",
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_id",
        "company_ids",
        "source_snapshot_ids",
        "source_policy_id",
        "knowledge_cutoff"
      ],
      "title": "ExecutionScope",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Calendar fiscal periods only; other fiscal calendars require a new adapter.",
      "properties": {
        "kind": {
          "enum": [
            "quarter",
            "ytd",
            "year",
            "instant"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ],
      "title": "Period",
      "type": "object"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordRequest"
          },
          "maxItems": 16,
          "title": "Records",
          "type": "array"
        },
        "documents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentRequest"
          },
          "maxItems": 4,
          "title": "Documents",
          "type": "array"
        },
        "calculations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CalculationRequest"
          },
          "maxItems": 8,
          "title": "Calculations",
          "type": "array"
        }
      },
      "title": "QueryPlan",
      "type": "object"
    },
    "QueryRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "query",
          "title": "Kind",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/QueryPlan"
        },
        "condition": {
          "const": "requested_records_and_calculations_returned",
          "default": "requested_records_and_calculations_returned",
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "requirement_id",
        "query"
      ],
      "title": "QueryRequirement",
      "type": "object"
    },
    "ReadRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "read_node",
          "title": "Kind",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "condition": {
          "const": "all_body_blocks_returned",
          "default": "all_body_blocks_returned",
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "requirement_id",
        "source_snapshot_id",
        "node_id"
      ],
      "title": "ReadRequirement",
      "type": "object"
    },
    "RecordRequest": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entity Id",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Metric Id",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_kind": {
          "default": "actual",
          "enum": [
            "actual",
            "management_guidance",
            "attributed_statement"
          ],
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "metric_id",
        "period"
      ],
      "title": "RecordRequest",
      "type": "object"
    },
    "RetrievalTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "requested_information": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requested Information",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "requirements": {
          "items": {
            "discriminator": {
              "mapping": {
                "clarification": "#/$defs/ClarificationRequirement",
                "query": "#/$defs/QueryRequirement",
                "read_node": "#/$defs/ReadRequirement"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ReadRequirement"
              },
              {
                "$ref": "#/$defs/QueryRequirement"
              },
              {
                "$ref": "#/$defs/ClarificationRequirement"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "requested_information",
        "source_snapshot_ids",
        "requirements"
      ],
      "title": "RetrievalTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "retrieval-task-plan-v1",
      "default": "retrieval-task-plan-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "revision": {
      "const": 1,
      "default": 1,
      "title": "Revision",
      "type": "integer"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ExecutionScope"
    },
    "origin": {
      "enum": [
        "caller",
        "scripted_fixture",
        "model"
      ],
      "title": "Origin",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/RetrievalTask"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "question",
    "scope",
    "origin",
    "tasks"
  ],
  "title": "TaskPlan",
  "type": "object"
}
