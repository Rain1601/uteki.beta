{
  "$defs": {
    "BlockRef": {
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "index_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Index Id",
          "type": "string"
        },
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "source_snapshot_id",
        "index_id",
        "block_id"
      ],
      "title": "BlockRef",
      "type": "object"
    },
    "RequirementProgress": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "read_node",
            "query",
            "clarification"
          ],
          "title": "Kind",
          "type": "string"
        },
        "availability": {
          "title": "Availability",
          "type": "string"
        },
        "required_body": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockRef"
          },
          "title": "Required Body",
          "type": "array"
        },
        "returned_body": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockRef"
          },
          "title": "Returned Body",
          "type": "array"
        },
        "unread_body": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockRef"
          },
          "title": "Unread Body",
          "type": "array"
        },
        "image_references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockRef"
          },
          "title": "Image References",
          "type": "array"
        },
        "non_body_blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlockRef"
          },
          "title": "Non Body Blocks",
          "type": "array"
        },
        "context_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Context Ids",
          "type": "array"
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "computed_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Computed Ids",
          "type": "array"
        },
        "last_read_cursor": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Read Cursor"
        },
        "first_unread": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_query_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Query Status"
        },
        "query_selections": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Query Selections",
          "type": "array"
        },
        "events": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Events",
          "type": "array"
        },
        "issues": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Issues",
          "type": "array"
        },
        "completion": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Completion",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "availability"
      ],
      "title": "RequirementProgress",
      "type": "object"
    },
    "TaskProgress": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementProgress"
          },
          "title": "Requirements",
          "type": "array"
        },
        "completion": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Completion",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "requirements"
      ],
      "title": "TaskProgress",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "retrieval-task-progress-v1",
      "default": "retrieval-task-progress-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_sha256": {
      "title": "Plan Sha256",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskProgress"
      },
      "title": "Tasks",
      "type": "array"
    },
    "semantic_completeness": {
      "const": "not_evaluated",
      "default": "not_evaluated",
      "title": "Semantic Completeness",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_sha256",
    "snapshot_id",
    "sequence",
    "tasks"
  ],
  "title": "ProgressSnapshot",
  "type": "object"
}
