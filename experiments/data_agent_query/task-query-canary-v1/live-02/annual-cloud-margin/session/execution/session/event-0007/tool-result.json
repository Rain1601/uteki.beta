        "text-align": "justify",
        "text-indent": "-18pt"
      },
      "table": null,
      "text": "•expenses relating to legal and other matters, including certain fines and settlements; and",
      "text_hash": "1b1a16277215cb5b11e029ef32b5926d3fb924b2bdaa03c8b725f23bfaef0473",
      "type": "paragraph"
    },
    {
