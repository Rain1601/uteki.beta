  "blocks": [
    {
      "block_id": "block-000519-66721118",
      "dom_path": "/html/body/div[556]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 519,
      "reported_page": 34,
      "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_100",
      "style_signature": {
