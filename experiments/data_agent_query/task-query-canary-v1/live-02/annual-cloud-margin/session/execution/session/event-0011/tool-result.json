        "margin-top": "6pt",
        "text-align": "justify",
        "text-indent": "22.5pt"
      },
      "table": null,
      "text": "Monetization Metrics",
      "text_hash": "7f2d9f6fb1eeb97ac2b30ac1580b6e1451bafb4fa60827c0488b90af60b60446",
      "type": "paragraph"
    },
