          "line-height": "120%",
          "margin-top": "6pt",
          "padding-left": "36pt",
          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "•seasonality.",
        "text_hash": "33c7f06064d7cf3eaaa05113c0e743f9dfb5c6e97182b1167d3ad140075dc218",
        "type": "paragraph"
      }
    ],
