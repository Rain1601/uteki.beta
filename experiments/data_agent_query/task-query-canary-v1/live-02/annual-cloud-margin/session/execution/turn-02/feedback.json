    "blocks": [
      {
        "block_id": "block-000399-f47ad6bb",
        "dom_path": "/html/body/div[429]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 399,
        "reported_page": 28,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_79",
        "style_signature": {
          "font-family": "'arial',sans-serif",
          "font-size": "10pt",
          "font-style": "italic",
          "font-weight": "700",
          "line-height": "120%",
          "margin-top": "6pt",
          "padding-left": "22.5pt",
          "text-align": "justify"
        },
        "table": null,
        "text": "Traffic Acquisition Costs Growth and Rate Changes: We expect traffic acquisition costs (\"TAC\") paid to our distribution partners and Google Network partners to increase as our advertising revenues grow. Our overall TAC as a percentage of our advertising revenues (\"TAC rate\") has been decreasing primarily due to a revenue mix",
        "text_hash": "f47ad6bb18e6f12d703b363839fc7f9fb77673f645fad41c8f99bd3820304e1d",
        "type": "paragraph"
      },
      {
