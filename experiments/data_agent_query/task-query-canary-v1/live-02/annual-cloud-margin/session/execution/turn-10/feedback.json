      {
        "block_id": "block-000515-ec7f6c39",
        "dom_path": "/html/body/div[552]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 515,
        "reported_page": 33,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_100",
        "style_signature": {
          "font-family": "'arial',sans-serif",
          "font-size": "10pt",
          "font-weight": "400",
          "line-height": "120%",
          "margin-top": "6pt",
          "text-align": "justify",
          "text-indent": "22.5pt"
        },
        "table": null,
        "text": "Google Search & other revenues increased $26.4 billion from 2024 to 2025. The overall growth was driven by interrelated factors including increases in search queries resulting from growth in user adoption and usage on mobile devices; growth in advertiser spending; and improvements we have made in ad formats and delivery.",
        "text_hash": "ec7f6c3962408395a51220d1b52012b44ba8494e6982e45ed08e1c127c8cf9ef",
