            "text-align": "justify"
          },
          "table": null,
          "text": "Google Cloud",
          "text_hash": "69bd2211a05e151338291eb88add1fcdd30966b4d92a1de7f3fb651f3e5078db",
          "type": "heading_candidate"
        },
        {
          "block_id": "block-000097-d95e78b6",
          "dom_path": "/html/body/div[109]",
          "image_asset_id": null,
          "layout_role": null,
          "ordinal": 97,
          "reported_page": 5,
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
          "style_signature": {
            "font-family": "'arial',sans-serif",
            "font-size": "10pt",
            "font-weight": "400",
            "line-height": "120%",
            "margin-top": "6pt",
            "text-align": "justify",
            "text-indent": "22.5pt"
          },
          "table": null,
          "text": "Through our Google Cloud Platform and Google Workspace offerings, Google Cloud generates revenues primarily from consumption-based fees and subscriptions for infrastructure, platform, applications, and other cloud services. Customers use Google Cloud in multiple ways such as:",
          "text_hash": "d95e78b68ab2a6077311c7644022bc0d91f9413013300a9996f678058a500123",
          "type": "paragraph"
        },
        {
