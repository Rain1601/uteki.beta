          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "•YouTube revenue across ads and subscriptions exceeded $60 billion for the full year 2025.",
        "text_hash": "6203298bf32eb9780543e1c4a50d1ddee139da466238d63477df7c2d1b0e1f79",
        "type": "list_item"
