        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 458,
        "reported_page": 31,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_85",
        "style_signature": {
          "font-family": "'arial',sans-serif",
          "font-size": "10pt",
          "font-weight": "400",
          "line-height": "120%",
          "margin-top": "6pt",
          "padding-left": "72pt",
          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "◦amounts paid to Google Network partners primarily for ads displayed on their properties.",
        "text_hash": "3320de4d720a17fe2cf00eca6f231c4be6d4e0c0a3ea968cec8c6a26d2a745c6",
        "type": "paragraph"
      },
      {
