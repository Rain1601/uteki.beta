          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "◦employee compensation expenses related to our technical infrastructure and other operations such as content review and customer and product support;",
        "text_hash": "ef1bfb7aee0522761ac8967c00e4b759698b78265dd3dc0730091e1712919046",
        "type": "paragraph"
      },
