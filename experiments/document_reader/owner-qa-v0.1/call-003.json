          "margin-top": "6pt",
          "padding-left": "72pt",
          "text-align": "justify",
          "text-indent": "-18pt"
        },
        "table": null,
        "text": "◦depreciation expense, primarily related to our technical infrastructure;",
        "text_hash": "fe9d35b5b7c9988865fbff693895eac8e89f0139ce0e979919b3787729b40fa1",
        "type": "paragraph"
      },
      {
